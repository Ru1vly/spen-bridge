<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.usb.accessory" android:required="false" />
    <application>
        <service android:name=".AccessoryRelayService" android:exported="false"
            android:process=":accessory_relay" />
        <receiver android:name=".InputTraceReceiver" android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
    <instrumentation android:name="com.spenbridge.app.AccessoryDiagnosticInstrumentation"
        android:targetPackage="com.spenbridge.app" android:label="Emulator accessory lifecycle tests" />
    <instrumentation
        android:name="com.spenbridge.app.USBDiagnosticInstrumentation"
        android:targetPackage="com.spenbridge.app"
        android:label="USB transport diagnostics" />
    <instrumentation android:name="com.spenbridge.app.UiUxAuditInstrumentation" android:targetPackage="com.spenbridge.app" android:label="Emulator UI UX audit" />
</manifest>
