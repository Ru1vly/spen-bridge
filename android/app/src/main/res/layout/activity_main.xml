<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_bg">

    <!-- Active S Pen Drawing & Capture Surface -->
    <com.spenbridge.app.PenSurfaceView
        android:id="@+id/penSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dynamic Status & Toolbar Overlay (Side in landscape, Top in portrait) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="8dp"
        android:background="@drawable/bar_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/statusContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusIndicator"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="6dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/status_disconnected"
                android:textColor="@color/text_light"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Spacer used in horizontal / portrait mode -->
        <View
            android:id="@+id/barSpacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnRotate"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="⟳ Rotate"
            android:textColor="@color/text_light"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSettings"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="⚙ Settings"
            android:textColor="@color/text_light"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCollapse"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="32dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="◀"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Minimized floating expand button when toolbar is collapsed -->
    <Button
        android:id="@+id/btnExpand"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="start|top"
        android:layout_margin="10dp"
        android:backgroundTint="#A014161C"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:padding="0dp"
        android:text="▶"
        android:textColor="@color/text_light"
        android:textSize="13sp"
        android:visibility="gone" />

</FrameLayout>
