[Desktop Entry]
Name=S Pen Bridge
# Template for packaged installs providing spen-bridge on PATH.
# Checkout installs generate an absolute-path entry through server.launcher.
GenericName=Graphics Tablet Controller
Comment=Turn Samsung Galaxy Tab and S Pen into a Linux graphics tablet
Exec=spen-bridge
Icon=spen_icon
Terminal=false
Type=Application
Categories=Graphics;2DGraphics;
Keywords=spen;tablet;wacom;stylus;samsung;krita;gimp;
StartupNotify=true
