; spenvhid.inf - root-enumerated software device, no bus, no hardware.
; DriverVer is intentionally left for the build to stamp (stampinf).
[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}   ; standard HIDClass GUID
Provider    = %ManufacturerName%
DriverVer   = ; filled by build (stampinf)
CatalogFile = spenvhid.cat
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = SpenVhid, NT$ARCH$

[SpenVhid.NT$ARCH$]
%SpenVhid.DeviceDesc% = SpenVhid_Device, root\spenvhid   ; root-enumerated

[SpenVhid_Device.NT]
CopyFiles = SpenVhid_CopyFiles

[DestinationDirs]
SpenVhid_CopyFiles = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
spenvhid.sys = 1

[SpenVhid_CopyFiles]
spenvhid.sys

[SpenVhid_Device.NT.HW]
AddReg = SpenVhid_Hardware

[SpenVhid_Hardware]
HKR,,LowerFilters,0x00010000,"vhf"
; Local interactive users can submit input; remote/network users cannot.
HKR,,Security,0x00000000,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[SpenVhid_Device.NT.Wdf]
KmdfService = spenvhid, SpenVhid_Wdf

[SpenVhid_Wdf]
KmdfLibraryVersion = $KMDFVERSION$

[SpenVhid_Device.NT.Services]
AddService = spenvhid, 0x00000002, SpenVhid_Service_Inst   ; 0x2 = SPSVCINST_ASSOCSERVICE

[SpenVhid_Service_Inst]
DisplayName    = %SpenVhid.SvcDesc%
ServiceType    = 1        ; SERVICE_KERNEL_DRIVER
StartType      = 3        ; SERVICE_DEMAND_START
ErrorControl   = 1        ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\spenvhid.sys

[Strings]
ManufacturerName     = "S Pen Bridge"
SpenVhid.DeviceDesc  = "S Pen Bridge Virtual HID Tablet"
SpenVhid.SvcDesc     = "S Pen Bridge Virtual HID Driver"

DiskName = "S Pen Bridge Driver"
