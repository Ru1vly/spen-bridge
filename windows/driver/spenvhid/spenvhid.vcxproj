<?xml version="1.0" encoding="utf-8"?>
<!--
  spenvhid.vcxproj - Phase 2a minimal KMDF driver project.

  Wiring for the NuGet-restored WDK follows the standard MSBuild "native
  package" import idiom (packages.<id>.props near the top, guarded by
  Exists() + an EnsureNuGetPackageBuildImports error target). Verified
  against the real, live-downloaded Microsoft.Windows.WDK.x64,
  Microsoft.Windows.SDK.CPP, and Microsoft.Windows.SDK.CPP.x64 NuGet
  packages during Phase 2a review: vhf.h (which device.c includes) lives
  in the SDK.CPP package, NOT the WDK.x64 package - Vhfkm.lib is the only
  VHF piece the WDK.x64 package actually contains - so all three packages'
  props must be imported, matching Microsoft's own Windows-driver-samples
  Directory.Build.props pattern. Only WDK.x64 and SDK.CPP ship a
  build\native\*.targets file (confirmed from the real packages);
  SDK.CPP.x64 is props-only.

  PlatformToolset below is still the classic
  WindowsKernelModeDriver10.0 name - this project is NOT fully independent
  of a machine-wide WDK install the way earlier drafts of this comment
  claimed. That toolset's registration (under VCTargetsPath's
  PlatformToolsets folder) comes from the Visual Studio "Windows Driver
  Kit" extension component, not from these NuGet packages. windows-2025 CI
  runners are confirmed (per actions/runner-images#14263) to have that VS
  component preinstalled even though the WDK content itself is not -
  exactly the gap these NuGet packages exist to fill. If that VS component
  is ever dropped from the runner image, this project would need a
  hand-authored Toolset.props/.targets shim (see README.md).
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="packages\Microsoft.Windows.WDK.x64.10.0.28000.2526\build\native\Microsoft.Windows.WDK.x64.props" Condition="Exists('packages\Microsoft.Windows.WDK.x64.10.0.28000.2526\build\native\Microsoft.Windows.WDK.x64.props')" />
  <Import Project="packages\Microsoft.Windows.SDK.CPP.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.props" Condition="Exists('packages\Microsoft.Windows.SDK.CPP.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.props')" />
  <Import Project="packages\Microsoft.Windows.SDK.CPP.x64.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.x64.props" Condition="Exists('packages\Microsoft.Windows.SDK.CPP.x64.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.x64.props')" />
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{B3B7F6E2-4C2A-4C41-9B7E-2B7B6E9E9A11}</ProjectGuid>
    <RootNamespace>spenvhid</RootNamespace>
    <Platform>x64</Platform>
    <MinimumVisualStudioVersion>15.0</MinimumVisualStudioVersion>
    <!-- Pinned to the WDK/SDK NuGet packages' own internal content version
         (their folder names are literally "10.0.28000.0"), not left
         floating as "10.0" - a floating version resolves against whatever
         SDK happens to be registered on the build machine, which on a
         windows-2025 runner is a different, older preinstalled SDK
         (10.0.26100.x per actions/runner-images#14263) that doesn't
         contain these NuGet packages' own km\wdm.h/ntddk.h tree at all. -->
    <WindowsTargetPlatformVersion>10.0.28000.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)'=='Debug'">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)'=='Release'">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <!--
    Real Phase 2a CI run (windows-2025, this exact package version) hit
    TRK0005: Failed to locate "stampinf.exe" during the StampInf build
    step. Confirmed by extracting the real package: stampinf.exe lives at
    c\bin\10.0.28000.0\x64\stampinf.exe, NOT under the x86 tools folder
    (c\bin\10.0.28000.0\x86\ only has Inf2Cat.exe/aitstatic.exe/DLLs) that
    WindowsDriver.Common.targets' StampInf target defaults InfToolPath to
    ($(WDKBinRoot_x86)) - a real packaging difference from the classic
    MSI-installed WDK, where stampinf.exe was x86-hosted. Overriding
    InfToolPath directly to the x64 folder this package actually ships it
    in; guarded by Exists() so this fails loudly instead of silently if a
    future WDK version moves it again.
  -->
  <PropertyGroup Condition="Exists('$(WdkContentRoot)bin\$(TargetPlatformVersion)\x64\stampinf.exe')">
    <InfToolPath>$(WdkContentRoot)bin\$(TargetPlatformVersion)\x64\</InfToolPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <PreprocessorDefinitions>%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <!-- Presence of Vhfkm.lib at link time is Phase 2a's real open-risk
           check - see device.c's SpenVhidProbeVhfConfigCompiles. -->
      <AdditionalDependencies>Vhfkm.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Inf>
      <OutputBaseFilename>spenvhid.inf</OutputBaseFilename>
    </Inf>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="driver.c" />
    <ClCompile Include="device.c" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="spenvhid.inf" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <!-- WDK.x64's package ships build\native\*.props only, no .targets -
         confirmed from the real package during Phase 2a review. Its actual
         driver build logic (WindowsDriver.*.props/.targets) is pulled in
         through the PlatformToolset's own Toolset.props/.targets chain via
         $(WDKContentRoot), not a package-level .targets file. Omitted here
         rather than importing a file that doesn't exist. -->
    <Import Project="packages\Microsoft.Windows.SDK.CPP.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.targets" Condition="Exists('packages\Microsoft.Windows.SDK.CPP.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.targets')" />
  </ImportGroup>
  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ErrorText>This project references a NuGet package that is missing on this computer. Run "nuget restore packages.config -PackagesDirectory packages" to fix. The missing file is {0}.</ErrorText>
    </PropertyGroup>
    <Error Condition="!Exists('packages\Microsoft.Windows.WDK.x64.10.0.28000.2526\build\native\Microsoft.Windows.WDK.x64.props')" Text="$([System.String]::Format('$(ErrorText)', 'packages\Microsoft.Windows.WDK.x64.10.0.28000.2526\build\native\Microsoft.Windows.WDK.x64.props'))" />
    <Error Condition="!Exists('packages\Microsoft.Windows.SDK.CPP.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.props')" Text="$([System.String]::Format('$(ErrorText)', 'packages\Microsoft.Windows.SDK.CPP.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.props'))" />
    <Error Condition="!Exists('packages\Microsoft.Windows.SDK.CPP.x64.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.x64.props')" Text="$([System.String]::Format('$(ErrorText)', 'packages\Microsoft.Windows.SDK.CPP.x64.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.x64.props'))" />
  </Target>
</Project>
